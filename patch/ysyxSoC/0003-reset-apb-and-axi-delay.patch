@@ -77,7 +77,7 @@ module axi4_delayer(
     // parameter FREQ_CPU
     // parameter FREQ_PER = 100;
 
-    parameter FACTOR = 10;
+    parameter FACTOR = 1;
      /* (freq - 1) * 1024  
         1003  -> 9247
         1018  -> 9400
@@ -89,7 +89,7 @@ module axi4_delayer(
         1072  -> 9953
         1140  -> 10650
     */

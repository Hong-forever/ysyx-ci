Subject: [PATCH 3/3] reset apb and axi delay


diff --git a/perip/amba/apb_delayer.v b/perip/amba/apb_delayer.v
index 64c92690..f8311eba 100644
--- a/perip/amba/apb_delayer.v
+++ b/perip/amba/apb_delayer.v
@@ -30,7 +30,7 @@ module apb_delayer(
     // parameter FREQ_CPU
     // parameter FREQ_PER = 100;
 
-    parameter FACTOR = 10;
+    parameter FACTOR = 0;
      /* (freq - 1) * 1024  
         1003  -> 9247
         1018  -> 9400
@@ -42,7 +42,7 @@ module apb_delayer(
         1072  -> 9953
         1140  -> 10650
     */

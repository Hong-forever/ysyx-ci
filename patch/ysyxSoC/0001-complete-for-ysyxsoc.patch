+    assign out_pprot   = in_pprot;
+    assign out_pwrite  = in_pwrite;
+    assign out_pwdata  = in_pwdata;
+    assign out_pstrb   = in_pstrb;
+    assign in_pready   = RATE_FIX == 0 ? out_pready : (state == WAIT) && (delay_counter == 1);
+    assign in_prdata   = RATE_FIX == 0 ? out_prdata : rdata;
+    assign in_pslverr  = out_pslverr;
 
 endmodule
diff --git a/perip/amba/axi4_delayer.v b/perip/amba/axi4_delayer.v
index f692803b..5989bb6f 100644
--- a/perip/amba/axi4_delayer.v
+++ b/perip/amba/axi4_delayer.v
@@ -62,35 +62,222 @@ module axi4_delayer(
   input  [3:0]  out_bid,
   input  [1:0]  out_bresp
 );
+    parameter IDLE     = 4'b0000;
+    parameter ARACCESS = 4'b0001;
+    parameter ARWAIT   = 4'b0010;
+    parameter RACCESS  = 4'b0011;
+    parameter RWAIT    = 4'b0100;
+    parameter AWACCESS = 4'b0101;
+    parameter AWWAIT   = 4'b0110;
+    parameter WACCESS  = 4'b0111;
+    parameter WWAIT    = 4'b1000;
+    parameter BACCESS  = 4'b1001;
+    parameter BWAIT    = 4'b1010;
 
-  assign in_arready = out_arready;
-  assign out_arvalid = in_arvalid;
-  assign out_arid = in_arid;
-  assign out_araddr = in_araddr;
-  assign out_arlen = in_arlen;
-  assign out_arsize = in_arsize;
-  assign out_arburst = in_arburst;
-  assign out_rready = in_rready;
-  assign in_rvalid = out_rvalid;
-  assign in_rid = out_rid;
-  assign in_rdata = out_rdata;
-  assign in_rresp = out_rresp;
-  assign in_rlast = out_rlast;
-  assign in_awready = out_awready;
-  assign out_awvalid = in_awvalid;
-  assign out_awid = in_awid;
-  assign out_awaddr = in_awaddr;
-  assign out_awlen = in_awlen;
-  assign out_awsize = in_awsize;
-  assign out_awburst = in_awburst;
-  assign in_wready = out_wready;
-  assign out_wvalid = in_wvalid;
-  assign out_wdata = in_wdata;
-  assign out_wstrb = in_wstrb;
-  assign out_wlast = in_wlast;
-  assign out_bready = in_bready;
-  assign in_bvalid = out_bvalid;
-  assign in_bid = out_bid;
-  assign in_bresp = out_bresp;
+    // parameter FREQ_CPU
+    // parameter FREQ_PER = 100;
+
+    parameter FACTOR = 10;
+     /* (freq - 1) * 1024  
+        1003  -> 9247
+        1018  -> 9400
+        974   -> 8950
+        854   -> 7721
+        869   -> 7875
+        796   -> 7127
+        736   -> 6512
+        1072  -> 9953
+        1140  -> 10650
+    */
+    parameter RATE_FIX = 10650; 
+    
+    reg [3:0] state, nstate;
+
+    reg [31:0] rdata;
+
+    reg [127:0] delay_counter;
+    reg [16:0] resp_delay;
+
+    always @(posedge clock) begin
+        if (reset) begin
+            state <= IDLE;
+        end else begin
+            state <= nstate;
+        end
+    end
+
+    always @(*) begin
+        if(reset) begin
+            nstate = IDLE;
+        end else begin
+            case(state)
+                IDLE: begin
+                    nstate = in_arvalid ? ARACCESS : (in_awvalid ? AWACCESS : IDLE);
+                end
+                ARACCESS: begin
+                    nstate = out_arready ? ARWAIT : ARACCESS;
+                end
+                ARWAIT: begin
+                    nstate = (delay_counter == 0) ? RACCESS : ARWAIT;
+                end
+                RACCESS: begin
+                    nstate = out_rvalid && in_rready ? RWAIT : RACCESS;
+                end
+                RWAIT: begin
+                    nstate = (resp_delay == 0) ? (out_rlast ? IDLE : RACCESS) : RWAIT;
+                end
+                AWACCESS: begin
+                    nstate = out_awready ? (in_wvalid & out_wready ? WWAIT : AWWAIT) : AWACCESS;
+                end
+                AWWAIT: begin
+                    nstate = (delay_counter == 0) ? WACCESS : AWWAIT;
+                end
+                WACCESS: begin
+                    nstate = out_wready && in_wvalid ? WWAIT : WACCESS;
+                end
+                WWAIT: begin
+                    nstate = (delay_counter == 0) ? (in_wlast ? BACCESS : WACCESS) : WWAIT;
+                end
+                BACCESS: begin
+                    nstate = out_bvalid && in_bready ? BWAIT : BACCESS;
+                end
+                BWAIT: begin
+                    nstate = (resp_delay == 0) ? IDLE : BWAIT;
+                end
+                default: begin
+                    nstate = IDLE;
+                end
+            endcase
+        end
+    end
+    
+    always @(posedge clock) begin
+        if(reset) begin
+            delay_counter <= 0;
+            resp_delay <= 0;
+        end else begin
+            case(state)
+                IDLE: begin
+                    delay_counter <= 0;
+                    resp_delay <= 0;
+                end
+                ARACCESS: begin
+                    if(!out_arready) begin
+                        delay_counter <= delay_counter + RATE_FIX;
+                    end else begin
+                        delay_counter <= delay_counter >> FACTOR;
+                        resp_delay <= resp_delay + RATE_FIX;
+                    end
+                end
+                ARWAIT: begin
+                    delay_counter <= delay_counter == 0 ? 0 : delay_counter - 1;
+                    if(!(out_rvalid && in_rready)) begin
+                        resp_delay <= resp_delay + RATE_FIX;
+                    end
+                end
+                RACCESS: begin
+                    if(!(out_rvalid && in_rready)) begin
+                        resp_delay <= resp_delay + RATE_FIX;
+                    end else begin
+                        resp_delay <= resp_delay >> FACTOR;
+                    end
+                end
+                RWAIT: begin
+                    resp_delay <= resp_delay == 0 ? 0 : resp_delay - 1;
+                end
+                AWACCESS: begin
+                    if(!out_awready) begin
+                        delay_counter <= delay_counter + RATE_FIX;
+                    end else begin
+                        delay_counter <= delay_counter >> FACTOR;
+                    end
+                end
+                AWWAIT: begin
+                    delay_counter <= delay_counter == 0 ? 0 : delay_counter - 1;
+                end
+                WACCESS: begin
+                    if(!(in_wvalid && out_wready)) begin
+                        delay_counter <= delay_counter + RATE_FIX;
+                    end else begin
+                        delay_counter <= delay_counter >> FACTOR;
+                    end
+                end
+                WWAIT: begin
+                    delay_counter <= delay_counter == 0 ? 0 : delay_counter - 1;
+                    if(!(out_bvalid && in_bready)) begin
+                        resp_delay <= resp_delay + RATE_FIX;
+                    end
+                end
+                BACCESS: begin
+                    if(!(out_bvalid && in_bready)) begin
+                        resp_delay <= resp_delay + RATE_FIX;
+                    end else begin
+                        resp_delay <= resp_delay >> FACTOR;
+                    end
+                end
+                BWAIT: begin
+                    resp_delay <= resp_delay == 0 ? 0 : resp_delay - 1;
+                end
+                default: begin
+                    delay_counter <= 0;
+                    resp_delay <= 0;
+                end
+            endcase
+        end
+    end
+
+    always @(posedge clock) begin
+        if(reset) begin
+            rdata <= 0;
+        end else if(state == RACCESS && out_rvalid) begin
+            rdata <= out_rdata;
+        end
+    end
+
+    reg arvalid;
+    reg awvalid;
+    reg wvalid;
+    always @(posedge clock) begin
+        if(reset) begin
+            arvalid <= 0;
+            awvalid <= 0;
+            wvalid <= 0;
+        end else begin
+            arvalid <= out_arready ? 0 : (state == ARACCESS || (state == IDLE && in_arvalid));
+            awvalid <= out_awready ? 0 : (state == AWACCESS || (state == IDLE && in_awvalid));
+            wvalid  <= out_wready  ? 0 : (state == WACCESS && in_wvalid);
+        end
+    end
+
+    assign in_arready = (state == ARWAIT) && (delay_counter == 0);
+    assign out_arvalid = arvalid;
+    assign out_arid = in_arid;
+    assign out_araddr = in_araddr;
+    assign out_arlen = in_arlen;
+    assign out_arsize = in_arsize;
+    assign out_arburst = in_arburst;
+    assign out_rready = (state == RWAIT) && (resp_delay == 0);
+    assign in_rvalid = (state == RWAIT) && (resp_delay == 0);
+    assign in_rid = out_rid;
+    assign in_rdata = rdata;
+    assign in_rresp = out_rresp;
+    assign in_rlast = out_rlast;
+
+    assign in_awready = (state == AWWAIT) && (delay_counter == 0) || (state == WWAIT) && (delay_counter == 0) && in_awvalid;
+    assign out_awvalid = awvalid;
+    assign out_awid = in_awid;
+    assign out_awaddr = in_awaddr;
+    assign out_awlen = in_awlen;
+    assign out_awsize = in_awsize;
+    assign out_awburst = in_awburst;
+    assign in_wready = (state == WWAIT) && (delay_counter == 0);
+    assign out_wvalid = wvalid || awvalid;
+    assign out_wdata = in_wdata;
+    assign out_wstrb = in_wstrb;
+    assign out_wlast = in_wlast;
+    assign out_bready = (state == BWAIT) && (resp_delay == 0);
+    assign in_bvalid = (state == BWAIT) && (resp_delay == 0);
+    assign in_bid = out_bid;
+    assign in_bresp = out_bresp;
 
 endmodule
diff --git a/perip/bitrev/bitrev.v b/perip/bitrev/bitrev.v
index f1c3b363..a3048d39 100644
--- a/perip/bitrev/bitrev.v
+++ b/perip/bitrev/bitrev.v
@@ -1,8 +1,34 @@
 module bitrev (
-  input  sck,
-  input  ss,
-  input  mosi,
-  output miso
+    input  sck,
+    input  ss,
+    input  mosi,
+    output reg miso
 );
-  assign miso = 1'b1;
+    reg [7:0] data;
+    reg [3:0] rx_cnt, tx_cnt;
+    reg flag;
+
+    always @(posedge sck or posedge ss) begin
+        if(ss) begin
+            data <= 8'd0;
+            rx_cnt <= 4'd0;
+            flag <= 1'b0;
+        end else if(rx_cnt < 4'd8) begin
+            data <= {data[6:0], mosi};
+            rx_cnt <= rx_cnt + 1;
+            flag <= rx_cnt == 4'd7 ? 1'b1 : flag;
+        end
+    end
+
+    always @(negedge sck or posedge ss) begin
+        if(ss) begin
+            miso <= 1'b1;
+            tx_cnt <= 4'd0;
+        end else if(flag && tx_cnt < 4'd8) begin
+            miso <= data[tx_cnt[2:0]];
+            tx_cnt <= tx_cnt + 1;
+        end
+    end
+
+
 endmodule
diff --git a/perip/gpio/gpio_top_apb.v b/perip/gpio/gpio_top_apb.v
index ec51ffe5..980dc14c 100644
--- a/perip/gpio/gpio_top_apb.v
+++ b/perip/gpio/gpio_top_apb.v
@@ -1,27 +1,115 @@
-module gpio_top_apb(
-  input         clock,
-  input         reset,
-  input  [31:0] in_paddr,
-  input         in_psel,
-  input         in_penable,
-  input  [2:0]  in_pprot,
-  input         in_pwrite,
-  input  [31:0] in_pwdata,
-  input  [3:0]  in_pstrb,
-  output        in_pready,
-  output [31:0] in_prdata,
-  output        in_pslverr,
-
-  output [15:0] gpio_out,
-  input  [15:0] gpio_in,
-  output [7:0]  gpio_seg_0,
-  output [7:0]  gpio_seg_1,
-  output [7:0]  gpio_seg_2,
-  output [7:0]  gpio_seg_3,
-  output [7:0]  gpio_seg_4,
-  output [7:0]  gpio_seg_5,
-  output [7:0]  gpio_seg_6,
-  output [7:0]  gpio_seg_7
+module gpio_top_apb
+(
+    input         clock,
+    input         reset,
+    input  [31:0] in_paddr,
+    input         in_psel,
+    input         in_penable,
+    input  [2:0]  in_pprot,
+    input         in_pwrite,
+    input  [31:0] in_pwdata,
+    input  [3:0]  in_pstrb,
+    output        in_pready,
+    output [31:0] in_prdata,
+    output        in_pslverr,
+
+    output [15:0] gpio_out,
+    input  [15:0] gpio_in,
+    output [7:0]  gpio_seg_0,
+    output [7:0]  gpio_seg_1,
+    output [7:0]  gpio_seg_2,
+    output [7:0]  gpio_seg_3,
+    output [7:0]  gpio_seg_4,
+    output [7:0]  gpio_seg_5,
+    output [7:0]  gpio_seg_6,
+    output [7:0]  gpio_seg_7
 );
 
+    parameter LED_ADDR = 4'h0;
+    parameter SW_ADDR = 4'h4;
+    parameter SEG_ADDR = 4'h8;
+
+    reg [15:0] LED;
+    reg [15:0] SW;
+    reg [31:0] SEG;
+
+    wire en = in_psel && in_penable;
+
+    integer i;
+    always @(posedge clock) begin
+        if(reset) begin
+            LED <= 0;
+            SEG <= 0;
+        end else if(en && in_pwrite) begin
+            case(in_paddr[3:0])
+                LED_ADDR: begin
+                    for(i=0; i<2; i=i+1) begin
+                        LED[i*8+:8] <= in_pstrb[i] ? in_pwdata[i*8+:8] : LED[i*8+:8];
+                    end
+                end
+                SEG_ADDR: begin
+                    for(i=0; i<4; i=i+1) begin
+                        SEG[i*8+:8] <= in_pstrb[i] ? in_pwdata[i*8+:8] : SEG[i*8+:8];
+                    end
+                end
+                default: begin
+                    
+                end
+            endcase
+        end
+    end
+
+    always @(posedge clock) begin
+        if(reset) begin
+            SW <= 0;
+        end else if(en && !in_pwrite) begin
+            SW <= in_paddr[3:0] == SW_ADDR ? gpio_in : SW;
+        end
+    end
+
+    wire [7:0] seg[15:0];
+    assign  seg[0]   = 8'b0000_0011;  // 0 - 03
+    assign  seg[1]   = 8'b1001_1111;  // 1 - 9F
+    assign  seg[2]   = 8'b0010_0101;  // 2 - 25
+    assign  seg[3]   = 8'b0000_1101;  // 3 - 0D
+    assign  seg[4]   = 8'b1001_1001;  // 4 - 99
+    assign  seg[5]   = 8'b0100_1001;  // 5 - 49
+    assign  seg[6]   = 8'b0100_0001;  // 6 - 41
+    assign  seg[7]   = 8'b0001_1111;  // 7 - 1F
+    assign  seg[8]   = 8'b0000_0001;  // 8 - 01
+    assign  seg[9]   = 8'b0000_1001;  // 9 - 09
+    assign  seg[10]  = 8'b0001_0001;  // A - 11
+    assign  seg[11]  = 8'b1100_0001;  // b - C1
+    assign  seg[12]  = 8'b0110_0011;  // C - 63
+    assign  seg[13]  = 8'b1000_0101;  // d - 85
+    assign  seg[14]  = 8'b0110_0001;  // E - 61
+    assign  seg[15]  = 8'b0111_0001;  // F - 71
+
+    reg ack;
+    always @(posedge clock) begin
+        if(reset) begin
+            ack <= 1'b0;
+        end else begin
+            ack <= en;
+        end
+    end
+
+    assign in_pready = ack;
+    assign in_pslverr = 1'b0;
+
+    assign in_prdata = (in_paddr[3:0] == LED_ADDR) ? {16'b0, LED} :
+                       (in_paddr[3:0] == SW_ADDR)  ? {16'b0, SW}  :
+                       (in_paddr[3:0] == SEG_ADDR) ? SEG :
+                       32'b0;
+
+    assign gpio_out = LED;
+    assign gpio_seg_0 = seg[SEG[3:0]];
+    assign gpio_seg_1 = seg[SEG[7:4]];
+    assign gpio_seg_2 = seg[SEG[11:8]];
+    assign gpio_seg_3 = seg[SEG[15:12]];
+    assign gpio_seg_4 = seg[SEG[19:16]];
+    assign gpio_seg_5 = seg[SEG[23:20]];

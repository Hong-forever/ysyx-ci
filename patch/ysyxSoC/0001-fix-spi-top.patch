+                        end
+                    end
+                end
+                STATE_WRITE: begin
+                    if(burst_cnt < burst_len) begin
+                        burst_cnt <= burst_cnt + 1;
+                    end
+                end
+                default: begin
+                    cas_cnt   <= 0;
+                    burst_cnt <= 0;
+                end
+            endcase
